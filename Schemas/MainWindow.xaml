<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ResidueSweep" Width="1280" Height="780" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Fg" Color="#161616"/>
        <SolidColorBrush x:Key="MutedFg" Color="#616161"/>
        <SolidColorBrush x:Key="Border" Color="#D8D8D8"/>
        <SolidColorBrush x:Key="Accent" Color="#0067C0"/>
        <SolidColorBrush x:Key="Hover" Color="#EEEEEE"/>
        <SolidColorBrush x:Key="Disabled" Color="#9A9A9A"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ResidueSweep" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Find hidden Windows caches and residual files, review every result, then clean safely." Foreground="{DynamicResource MutedFg}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LanguageBtn" Content="Language" AutomationProperties.Name="Language"/>
                <Button x:Name="ThemeBtn" Content="Theme" AutomationProperties.Name="Theme"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Selected" Foreground="{DynamicResource MutedFg}"/><TextBlock x:Name="CleanupSelectedCountText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Scan results" Foreground="{DynamicResource MutedFg}"/><TextBlock x:Name="CleanupResultCountText" Text="--" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Estimated space" Foreground="{DynamicResource MutedFg}"/><TextBlock x:Name="CleanupResultSizeText" Text="--" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Quarantine history" Foreground="{DynamicResource MutedFg}"/><TextBlock x:Name="CleanupHistoryCountText" Text="0" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Cleanup areas" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Nothing changes until you scan, review, and confirm." Foreground="{DynamicResource MutedFg}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CleanupSelectAllBtn" Content="Select all"/><Button x:Name="CleanupClearSelectionBtn" Content="Clear"/></StackPanel>
                    </Grid>
                    <ListBox x:Name="CleanupCapabilityList" Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{DynamicResource MutedFg}" FontSize="12" TextWrapping="Wrap"><Run Text="{Binding Area}"/><Run Text="  |  "/><Run Text="{Binding Safety}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12"><TextBlock Text="Review scan results" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Only paths shown by the latest scan can be cleaned." Foreground="{DynamicResource MutedFg}"/></StackPanel>
                    <Grid>
                        <ListBox x:Name="CleanupPreviewList" Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="12,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,1,8,0">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanSelect}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding CapabilityName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedFg}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Mode}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SizeMiB, StringFormat={}{0:N2} MiB}" Foreground="{DynamicResource MutedFg}" FontSize="12" HorizontalAlignment="Right"/></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="CleanupPreviewEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30">
                            <TextBlock Text="1" Background="{DynamicResource Accent}" Foreground="White" FontSize="20" Width="42" Height="42" TextAlignment="Center" Padding="0,7"/>
                            <TextBlock Text="Choose cleanup areas" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock x:Name="CleanupPreviewEmptyText" Text="Run a scan to see files, records, and estimated space." Foreground="{DynamicResource MutedFg}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="430"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="CleanupStatusText" Text="Choose cleanup areas, scan, review, then clean." TextWrapping="Wrap" Margin="2,0,2,10"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CleanupExclusionsBtn" Content="Exclusions"/>
                        <Button x:Name="CleanupRestoreBtn" Content="Undo latest" IsEnabled="False"/>
                        <Button x:Name="CleanupPurgeBtn" Content="Delete latest quarantine" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CleanupScanBtn" Content="Scan selected"/>
                        <Button x:Name="CleanupQuarantineBtn" Content="Review and clean" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
